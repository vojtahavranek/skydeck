#!/bin/sh
# skydeck launcher: picks the Node.js binary and runs bin/bootstrap.mjs with the same arguments.
#
# Node is chosen by, in order:
#   1. $SKYDECK_NODE
#   2. the symlink <dataDir>/node, if it points at an executable, where <dataDir> is
#      $SKYDECK_HOME/data when SKYDECK_HOME is set (tests), else
#      ${XDG_DATA_HOME:-$HOME/.local/share}/skydeck (design 9.1);
#      an environment variable counts only when it is an absolute path (D26)
#   3. `node` from PATH
# so the launcher does not depend on the shell's default Node version.
#
# It also runs the handoff `skydeck resume --here` asks for (design 7.6): node writes a shell
# fragment to the file named by $SKYDECK_HANDOFF, and once node has exited the launcher runs it, so
# that `claude` replaces this shell and no wrapper process stays behind.
#
# The program the handoff starts gets the caller's environment, apart from SKYDECK_HANDOFF (unset
# before it runs). So the launcher's own shell variables carry a `skydeck_` prefix: a variable the
# caller exported under a plain name such as `status` or `cache` is changed by an assignment here,
# and the changed value would be inherited. CDPATH is unset only where a `cd` needs it unset.

# Find the real location of this file; it may be reached through (a chain of) symlinks. A set
# CDPATH would make the relative `cd`s land in the wrong directory, so it is unset inside them.
skydeck_self=$0
while [ -h "$skydeck_self" ]; do
  skydeck_dir=$(unset CDPATH; cd -P -- "$(dirname -- "$skydeck_self")" && pwd) || exit 1
  skydeck_target=$(readlink -- "$skydeck_self") || exit 1
  case $skydeck_target in
    /*) skydeck_self=$skydeck_target ;;
    *) skydeck_self=$skydeck_dir/$skydeck_target ;;
  esac
done
skydeck_root=$(unset CDPATH; cd -P -- "$(dirname -- "$skydeck_self")/.." && pwd) || exit 1

# True if $1 can be run: an executable regular file when it is a path, a command on PATH when it
# is a bare name. (`-x` alone is true for directories, and `command -v` of a path only checks that
# it exists, so neither is enough by itself.)
runnable() {
  case $1 in
    */*) [ -f "$1" ] && [ -x "$1" ] ;;
    *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

# D26: SKYDECK_HOME and XDG_DATA_HOME count only when they are absolute paths (which also rules out
# an empty value); a relative one would depend on the directory the user happens to be in.
case ${SKYDECK_HOME:-} in
  /*) skydeck_linked_node=$SKYDECK_HOME/data/node ;;
  *)
    case ${XDG_DATA_HOME:-} in
      /*) skydeck_linked_node=$XDG_DATA_HOME/skydeck/node ;;
      *) skydeck_linked_node=$HOME/.local/share/skydeck/node ;;
    esac
    ;;
esac
if [ -n "${SKYDECK_NODE:-}" ]; then
  skydeck_node=$SKYDECK_NODE
elif runnable "$skydeck_linked_node"; then
  skydeck_node=$skydeck_linked_node
else
  skydeck_node=node
fi

if ! runnable "$skydeck_node"; then
  echo "skydeck: cannot run '$skydeck_node'; install Node.js or set SKYDECK_NODE to a node binary." >&2
  exit 127
fi

# Cache compiled modules between runs; the start-up time of a short command is mostly compiling.
# It is given to node alone below, not exported: the program the --here handoff starts must not
# inherit skydeck's cache, but a NODE_COMPILE_CACHE the user set is theirs and stays as it was.
if [ -n "${NODE_COMPILE_CACHE:-}" ]; then
  skydeck_cache=$NODE_COMPILE_CACHE
else
  case ${XDG_CACHE_HOME:-} in
    /*) skydeck_cache=$XDG_CACHE_HOME/skydeck/compile-cache ;;
    *) skydeck_cache=$HOME/.cache/skydeck/compile-cache ;;
  esac
fi

# The handoff file: node writes "cd -- <dir> || exit 1" and "exec <program and arguments>", every
# word quoted for sh (src/terminals/here.ts), and exits. The launcher reads it, deletes it and only
# then runs it, so no handoff file outlives the launcher, and the exec'd program does not inherit
# the variable. Without a handoff the launcher exits with node's status.
# $TMPDIR is used only when it is an absolute path to a directory (a relative one would name another
# file once the handoff has changed directory); if the file cannot be created there, or $TMPDIR is
# unusable, it goes to /tmp, and only a failure there ends the launcher.
skydeck_tmp=/tmp
case ${TMPDIR:-} in
  /*) if [ -d "$TMPDIR" ]; then skydeck_tmp=$TMPDIR; fi ;;
esac
skydeck_handoff=$(mktemp "$skydeck_tmp/skydeck-handoff.XXXXXX" 2>/dev/null ||
  mktemp /tmp/skydeck-handoff.XXXXXX) || exit 1
trap 'rm -f -- "$skydeck_handoff"' EXIT
trap 'exit 130' HUP INT TERM
trap 'exit 131' QUIT
SKYDECK_HANDOFF=$skydeck_handoff
export SKYDECK_HANDOFF
skydeck_status=0
NODE_COMPILE_CACHE=$skydeck_cache "$skydeck_node" "$skydeck_root/bin/bootstrap.mjs" "$@" ||
  skydeck_status=$?
if [ -s "$skydeck_handoff" ]; then
  skydeck_script=$(cat -- "$skydeck_handoff")
  rm -f -- "$skydeck_handoff"
  trap - EXIT
  unset SKYDECK_HANDOFF
  eval "$skydeck_script"
fi
exit "$skydeck_status"
