#!/bin/sh
# skydeck launcher: picks the Node.js binary and runs bin/bootstrap.mjs with the same arguments.
#
# Node is chosen by, in order:
#   1. $SKYDECK_NODE
#   2. the symlink <dataDir>/node, if it points at an executable, where <dataDir> is
#      $SKYDECK_HOME/data when SKYDECK_HOME is set (tests), else
#      ${XDG_DATA_HOME:-$HOME/.local/share}/skydeck (design 9.1);
#      an environment variable counts only when it is an absolute path (D26)
#   3. `node` from PATH
# so the launcher does not depend on the shell's default Node version. For `serve` (the window's
# server) node is started through a short python3 program that keeps its core dumps from being
# written (S2 2; see below).
#
# It also runs the handoff `skydeck resume --here` asks for (design 7.6): node writes a shell
# fragment to the file named by $SKYDECK_HANDOFF, and once node has exited the launcher runs it, so
# that `claude` replaces this shell and no wrapper process stays behind.
#
# The program the handoff starts gets the caller's environment, apart from SKYDECK_HANDOFF (unset
# before it runs). So the launcher's own shell variables carry a `skydeck_` prefix: a variable the
# caller exported under a plain name such as `status` or `cache` is changed by an assignment here,
# and the changed value would be inherited. CDPATH is unset only where a `cd` needs it unset.

# Find the real location of this file; it may be reached through (a chain of) symlinks. A set
# CDPATH would make the relative `cd`s land in the wrong directory, so it is unset inside them.
skydeck_self=$0
while [ -h "$skydeck_self" ]; do
  skydeck_dir=$(unset CDPATH; cd -P -- "$(dirname -- "$skydeck_self")" && pwd) || exit 1
  skydeck_target=$(readlink -- "$skydeck_self") || exit 1
  case $skydeck_target in
    /*) skydeck_self=$skydeck_target ;;
    *) skydeck_self=$skydeck_dir/$skydeck_target ;;
  esac
done
skydeck_root=$(unset CDPATH; cd -P -- "$(dirname -- "$skydeck_self")/.." && pwd) || exit 1

# True if $1 can be run: an executable regular file when it is a path, a command on PATH when it
# is a bare name. (`-x` alone is true for directories, and `command -v` of a path only checks that
# it exists, so neither is enough by itself.)
runnable() {
  case $1 in
    */*) [ -f "$1" ] && [ -x "$1" ] ;;
    *) command -v "$1" >/dev/null 2>&1 ;;
  esac
}

# D26: SKYDECK_HOME and the XDG variables count only when they are absolute paths (which also rules
# out an empty value); a relative one would depend on the directory the user happens to be in.
case ${SKYDECK_HOME:-} in
  /*)
    skydeck_data=$SKYDECK_HOME/data
    skydeck_state=$SKYDECK_HOME/state
    ;;
  *)
    case ${XDG_DATA_HOME:-} in
      /*) skydeck_data=$XDG_DATA_HOME/skydeck ;;
      *) skydeck_data=$HOME/.local/share/skydeck ;;
    esac
    case ${XDG_STATE_HOME:-} in
      /*) skydeck_state=$XDG_STATE_HOME/skydeck ;;
      *) skydeck_state=$HOME/.local/state/skydeck ;;
    esac
    ;;
esac
skydeck_linked_node=$skydeck_data/node
if [ -n "${SKYDECK_NODE:-}" ]; then
  skydeck_node=$SKYDECK_NODE
elif runnable "$skydeck_linked_node"; then
  skydeck_node=$skydeck_linked_node
else
  skydeck_node=node
fi

if ! runnable "$skydeck_node"; then
  echo "skydeck: cannot run '$skydeck_node'; install Node.js or set SKYDECK_NODE to a node binary." >&2
  exit 127
fi

# Cache compiled modules between runs; the start-up time of a short command is mostly compiling.
# It is given to node alone below, not exported: the program the --here handoff starts must not
# inherit skydeck's cache, but a NODE_COMPILE_CACHE the user set is theirs and stays as it was.
# When the launcher chose the cache itself, node also gets SKYDECK_LAUNCHER_CACHE with the same
# value: the marker by which the window's server knows that NODE_COMPILE_CACHE is skydeck's and
# leaves it out of its programs' environment (S2 5.2). A NODE_COMPILE_CACHE the caller set gets no
# marker, and a marker the caller has is left as it is: when `skydeck window` starts `serve`, its
# own launcher's cache and marker come in that way and must still reach the server together.
if [ -n "${NODE_COMPILE_CACHE:-}" ]; then
  skydeck_cache=$NODE_COMPILE_CACHE
  skydeck_marker=
else
  case ${XDG_CACHE_HOME:-} in
    /*) skydeck_cache=$XDG_CACHE_HOME/skydeck/compile-cache ;;
    *) skydeck_cache=$HOME/.cache/skydeck/compile-cache ;;
  esac
  skydeck_marker=$skydeck_cache
fi

# `serve` keeps every terminal's screen, the secret and its environment in memory, and on WSL a
# crashing process's core dump is piped to a crash collector that keeps it in a Windows folder. A
# core limit of 0 does not stop a piped dump; only a soft limit of exactly 1 byte does, and sh's
# `ulimit -c` counts in blocks. So node is started for `serve` through this python3 program
# (S2 2): it sets the soft core limit to 1 byte, keeps the hard limit, puts the soft limit it found
# into SKYDECK_CORE_SOFT (bytes in decimal, or `unlimited`; the keepers give it back to the
# programs they start) and execs node. When the limit cannot be set it still execs node, without
# SKYDECK_CORE_SOFT, and appends one line saying so to server.log (to stderr when that cannot be
# written). Run with -I, so nothing from the environment or the working directory reaches python.
# Node must start as it would without python in between: python3 sets LC_CTYPE in its own
# environment when the locale is C (PEP 538), so the caller's LC_CTYPE is given back, and the
# signals python ignores (SIGPIPE, SIGXFSZ; an ignored signal stays ignored across exec) are reset
# to their default, as python's own subprocess does.
skydeck_core_limit='
import datetime, os, resource, signal, sys

log, ctype_was_set, ctype, command = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4:]
env = dict(os.environ)
if ctype_was_set:
    env["LC_CTYPE"] = ctype
else:
    env.pop("LC_CTYPE", None)
for name in ("SIGPIPE", "SIGXFSZ"):
    signal.signal(getattr(signal, name), signal.SIG_DFL)
env.pop("SKYDECK_CORE_SOFT", None)
try:
    soft, hard = resource.getrlimit(resource.RLIMIT_CORE)
    if hard == 0:
        raise ValueError("the hard limit is 0")
    resource.setrlimit(resource.RLIMIT_CORE, (1, hard))
    env["SKYDECK_CORE_SOFT"] = "unlimited" if soft == resource.RLIM_INFINITY else str(soft)
except (OSError, ValueError) as error:
    now = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")
    line = "%s launcher: the soft core limit could not be set to 1 byte (%s); core dumps of the server are not prevented\n" % (now.replace("+00:00", "Z"), error)
    try:
        with open(log, "a") as file:
            file.write(line)
    except OSError:
        sys.stderr.write(line)
try:
    os.execvpe(command[0], command, env)
except OSError as error:
    sys.stderr.write("skydeck: cannot run %r: %s\n" % (command[0], error.strerror))
    sys.exit(127)
'

# The handoff file: node writes "cd -- <dir> || exit 1" and "exec <program and arguments>", every
# word quoted for sh (src/terminals/here.ts), and exits. The launcher reads it, deletes it and only
# then runs it, so no handoff file outlives the launcher, and the exec'd program does not inherit
# the variable. Without a handoff the launcher exits with node's status.
# $TMPDIR is used only when it is an absolute path to a directory (a relative one would name another
# file once the handoff has changed directory); if the file cannot be created there, or $TMPDIR is
# unusable, it goes to /tmp, and only a failure there ends the launcher.
skydeck_tmp=/tmp
case ${TMPDIR:-} in
  /*) if [ -d "$TMPDIR" ]; then skydeck_tmp=$TMPDIR; fi ;;
esac
skydeck_handoff=$(mktemp "$skydeck_tmp/skydeck-handoff.XXXXXX" 2>/dev/null ||
  mktemp /tmp/skydeck-handoff.XXXXXX) || exit 1
trap 'rm -f -- "$skydeck_handoff"' EXIT
trap 'exit 130' HUP INT TERM
trap 'exit 131' QUIT
SKYDECK_HANDOFF=$skydeck_handoff
export SKYDECK_HANDOFF
skydeck_status=0
# Node runs in a subshell: the variables set for it here never reach the launcher's own
# environment, which the handoff's program inherits.
(
  NODE_COMPILE_CACHE=$skydeck_cache
  export NODE_COMPILE_CACHE
  if [ -n "$skydeck_marker" ]; then
    SKYDECK_LAUNCHER_CACHE=$skydeck_marker
    export SKYDECK_LAUNCHER_CACHE
  fi
  if [ "${1-}" != serve ]; then
    exec "$skydeck_node" "$skydeck_root/bin/bootstrap.mjs" "$@"
  elif runnable python3; then
    # After the program: where to log, the caller's LC_CTYPE (set or not, and its value), then
    # node's command line.
    exec python3 -I -c "$skydeck_core_limit" "$skydeck_state/server.log" \
      "${LC_CTYPE+set}" "${LC_CTYPE-}" "$skydeck_node" "$skydeck_root/bin/bootstrap.mjs" "$@"
  else
    # Without python3 the server's core dumps are not prevented (S2 2); a SKYDECK_CORE_SOFT the
    # caller had must not pass for a limit that was set.
    unset SKYDECK_CORE_SOFT
    exec "$skydeck_node" "$skydeck_root/bin/bootstrap.mjs" "$@"
  fi
) || skydeck_status=$?
if [ -s "$skydeck_handoff" ]; then
  skydeck_script=$(cat -- "$skydeck_handoff")
  rm -f -- "$skydeck_handoff"
  trap - EXIT
  unset SKYDECK_HANDOFF
  eval "$skydeck_script"
fi
exit "$skydeck_status"
