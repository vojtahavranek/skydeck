#!/bin/sh
# skydeck keep-alive: skydeck-keepalive <runtime directory>   (design-step-2 6.1, plan task 7)
#
# The server starts this through interop, detached, as
#   wsl.exe -d <distribution> -u <user> --exec /bin/sh <checkout>/bin/skydeck-keepalive <runtimeDir>
# so that one Windows client of the distribution, and with it WSL, stays alive while the window
# has anything to keep. In the runtime directory it writes, each through a temporary name and a
# rename, so that a reader never sees a part of one:
#   keepalive.pid      its own pid line, "<pid> <process start> <boot id>" (plan contract 2.8);
#   keepalive.interop  its $WSL_INTEROP exactly, no newline added; empty when that is unset
#                      (design-step-2 6.4). Judging the value is the reader's job.
# Then, every 10 seconds, it checks whether server.pid or any terms/*.pid names a process alive by
# design 5.5's rule (same boot id; /proc/<pid>/stat exists and gives the recorded process start).
# When none does it exits 0. On SIGHUP, SIGINT or SIGTERM it exits at once, 128 + the signal's
# number. Whenever it exits it removes keepalive.pid, as long as that still holds its own line.
#
# Rules: sh builtins plus sleep, mv and rm only, and rm removes nothing but keepalive.pid (above)
# and its own temporary file after a failed write; nothing on stdout. Exit 2: wrong arguments (a
# usage line on stderr); exit 1: it could not read its own process start or the boot id, could not
# write its files (the shell's message on stderr), or sleep failed.
#
# SKYDECK_TEST_KEEPALIVE_SECONDS sets the interval, for tests only (plan A31): a whole number of
# at least 1, written without leading zeros; anything else gives the 10 seconds.

# The files are the user's own, like the runtime directory (mode 700).
umask 077

nl='
'

dir=
boot_id=
own_line=
tmp=
sleeper=

usage() {
  printf 'usage: skydeck-keepalive <runtime directory>\n' >&2
  exit 2
}

# Sets $proc_start to the process start of pid $1: field 22 of /proc/$1/stat, counted after the
# last ")" (design 5.5). Empty when the file cannot be read or has another form. The process name
# before that ")" can hold ")", spaces and even newlines; the fields after it never hold a newline,
# so the file's last line holds them all. The file is read in a subshell: a shell may exit on a
# redirection that fails for a compound command (POSIX 2.8.1), and the process can end at any time.
read_proc_start() {
  proc_start=
  last=$(
    stat_line=
    { while IFS= read -r stat_part; do stat_line=$stat_part; done <"/proc/$1/stat"; } 2>/dev/null
    printf '%s' "$stat_line"
  )
  case $last in
    *")"*) ;;
    *) return 0 ;;
  esac
  set -f
  # The fields are split on purpose: one state letter and numbers, separated by single spaces.
  # shellcheck disable=SC2086
  set -- ${last##*")"}
  set +f
  [ $# -ge 20 ] || return 0
  shift 19
  case $1 in
    '' | *[!0-9]*) ;;
    *) proc_start=$1 ;;
  esac
}

# True when the file $1 holds a pid line (plan contract 2.8; a keeper's two extra fields are
# ignored) naming a process alive by design 5.5's rule. A missing, empty or garbled file is false.
line_alive() {
  pid=
  start=
  boot=
  { IFS=' ' read -r pid start boot _ <"$1"; } 2>/dev/null
  case $pid in
    '' | *[!0-9]*) return 1 ;;
  esac
  case $start in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ "$boot" = "$boot_id" ] || return 1
  read_proc_start "$pid"
  [ -n "$proc_start" ] && [ "$proc_start" = "$start" ]
}

# True when the server or any keeper is alive.
any_alive() {
  line_alive "$dir/server.pid" && return 0
  for file in "$dir"/terms/*.pid; do
    # Without a match the pattern stays as it is, and names no file.
    [ -f "$file" ] || continue
    line_alive "$file" && return 0
  done
  return 1
}

# Writes the text $2 to the file $1 in the runtime directory through a temporary name and a rename.
write_file() {
  tmp=$dir/.$1.$$.tmp
  printf '%s' "$2" >"$tmp" || return 1
  mv -f -- "$tmp" "$dir/$1" || return 1
  tmp=
}

cleanup() {
  if [ -n "$sleeper" ]; then
    kill "$sleeper" 2>/dev/null
  fi
  if [ -n "$tmp" ]; then
    rm -f -- "$tmp"
  fi
  if [ -n "$own_line" ]; then
    line=
    { IFS= read -r line <"$dir/keepalive.pid"; } 2>/dev/null
    # Another keep-alive may have written its own line since; that one stays.
    if [ "$line" = "$own_line" ]; then
      rm -f -- "$dir/keepalive.pid"
    fi
  fi
}

main() {
  [ $# -eq 1 ] || usage
  case $1 in
    /*) ;;
    *) usage ;;
  esac
  [ -d "$1" ] || usage
  dir=$1

  interval=${SKYDECK_TEST_KEEPALIVE_SECONDS-}
  case $interval in
    '' | *[!0-9]* | 0*) interval=10 ;;
  esac

  trap cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  { read -r boot_id </proc/sys/kernel/random/boot_id; } 2>/dev/null
  [ -n "$boot_id" ] || exit 1
  read_proc_start "$$"
  [ -n "$proc_start" ] || exit 1

  # keepalive.interop first: whoever sees keepalive.pid can read it.
  write_file keepalive.interop "${WSL_INTEROP-}" || exit 1
  own_line="$$ $proc_start $boot_id"
  write_file keepalive.pid "$own_line$nl" || exit 1

  while :; do
    # In the background, so that a signal is handled at once rather than after the sleep.
    sleep "$interval" &
    sleeper=$!
    # A sleep that fails would make this a busy loop.
    wait "$sleeper" || exit 1
    sleeper=
    any_alive || exit 0
  done
}

main "$@"
