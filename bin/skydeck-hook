#!/bin/sh
# skydeck hook: skydeck-hook <SessionStart|SessionEnd>   (design 5.1 and 5.2, plan 2.10.1)
#
# Claude Code runs this for the two hooked events. It writes one spool file and does nothing else.
# Rules (design principle 3): it prints nothing, it always exits 0, it uses only sh builtins plus
# date, cat, base64, mkdir and mv, and it interprets nothing: reading the file is ingest's job.
# Its own errors are appended to hook.log in the state directory; when even that fails they are
# dropped.

# The spool holds working directories and launch command lines, so it is private to the user.
umask 077

# A newline in a value would add header lines to the spool file, and a carriage return would do the
# same for a reader that treats it as a line end, so such a value is written empty (a value never
# contains one in practice; a directory name can).
nl='
'

# Appends one line to hook.log, creating the state directory when it is missing. Failing to log is
# not worth a second error. The error text of a program can have several lines; each newline in it
# becomes a space, so that a message is one line and every line of the file starts with its time.
log() {
  [ -d "$state" ] || mkdir -p -- "$state"
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ) || now=-
  msg=$1
  while :; do
    case $msg in
      *"$nl"*) msg="${msg%%"$nl"*} ${msg#*"$nl"}" ;;
      *) break ;;
    esac
  done
  printf '%s %s %s\n' "$now" "$event" "$msg" >>"$state/hook.log"
}

# Sets $state as design 9.1 says (D26): $SKYDECK_HOME/state, else $XDG_STATE_HOME/skydeck, else
# $HOME/.local/state/skydeck; a variable counts only when it is absolute (starts with a slash).
# $state stays empty when not even HOME is usable.
resolve_state() {
  state=
  case ${SKYDECK_HOME-} in
    /*)
      state=$SKYDECK_HOME/state
      return
      ;;
  esac
  case ${XDG_STATE_HOME-} in
    /*)
      state=$XDG_STATE_HOME/skydeck
      return
      ;;
  esac
  case ${HOME-} in
    /*) state=$HOME/.local/state/skydeck ;;
  esac
}

main() {
  # First, so that the time is as close to the event as it can be.
  time_ns=$(date +%s%N)

  cr=$(printf '\r') # $(...) strips only trailing newlines
  event=${1-}
  session_env=${CLAUDE_CODE_SESSION_ID-}
  entrypoint_env=${CLAUDE_CODE_ENTRYPOINT-}
  cwd=${PWD-}
  case $event in *"$nl"* | *"$cr"*) event= ;; esac
  case $session_env in *"$nl"* | *"$cr"*) session_env= ;; esac
  case $entrypoint_env in *"$nl"* | *"$cr"*) entrypoint_env= ;; esac
  case $cwd in *"$nl"* | *"$cr"*) cwd= ;; esac

  resolve_state
  if [ -z "$state" ]; then
    return
  fi
  # The time and the pid become part of a file name; nothing else may.
  case $time_ns in
    '' | *[!0-9]*)
      log "date gave '$time_ns' instead of a number of nanoseconds"
      return
      ;;
  esac
  pid=${CLAUDE_PID-}
  case $pid in
    '' | *[!0-9]*) pid= ;;
  esac

  # An unreadable /proc entry gives an empty value; ingest copes with that.
  stat=
  argv=
  boot_id=
  if [ -n "$pid" ]; then
    read -r stat <"/proc/$pid/stat" || stat=
    if [ "$event" = SessionStart ]; then
      argv=$(base64 -w 0 <"/proc/$pid/cmdline") || argv=
    fi
  fi
  read -r boot_id </proc/sys/kernel/random/boot_id || boot_id=

  spool=$state/spool
  name=$time_ns-${pid:-0}-$$.ev
  tmp=$spool/.$name.tmp

  if [ ! -d "$spool" ]; then
    # -m applies to the spool directory only, which is what is wanted: it closes the directory to
    # others even where a default ACL on the parent overrides the umask.
    # shellcheck disable=SC2174
    if ! err=$(mkdir -p -m 700 -- "$spool" 2>&1); then
      log "$err"
      return
    fi
  fi

  # The standard error of the group goes to $err, its standard output to the file.
  if ! err=$(
    {
      printf 'v=1\nevent=%s\ntime_ns=%s\nclaude_pid=%s\nsession_env=%s\nentrypoint_env=%s\nboot_id=%s\nstat=%s\npwd=%s\n' \
        "$event" "$time_ns" "$pid" "$session_env" "$entrypoint_env" \
        "$boot_id" "$stat" "$cwd" &&
        if [ "$event" = SessionStart ]; then printf 'argv_b64=%s\n' "$argv"; fi &&
        printf -- '--\n' &&
        cat
    } 2>&1 >"$tmp"
  ); then
    log "write failed: $err"
    return
  fi

  if ! err=$(mv -f -- "$tmp" "$spool/$name" 2>&1); then
    log "$err"
  fi
}

main "$@" >/dev/null 2>&1
exit 0
