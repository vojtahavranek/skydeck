#!/bin/sh
# skydeck hook: skydeck-hook <SessionStart|SessionEnd>   (design 5.1 and 5.2, plan 2.10.1)
#
# Claude Code runs this for the two hooked events. It writes one spool file and does nothing else.
# Rules (design principle 3): it prints nothing, it always exits 0, it uses only sh builtins plus
# date, cat, base64, mkdir and mv, and it interprets nothing: reading the file is ingest's job.
# Its own errors are appended to hook.log in the state directory; when even that fails they are
# dropped.

# Appends one line to hook.log. Failing to log is not worth a second error.
log() {
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ) || now=-
  printf '%s %s %s\n' "$now" "$event" "$1" >>"$state/hook.log"
}

# Sets $state as design 9.1 says (D26): $SKYDECK_HOME/state, else $XDG_STATE_HOME/skydeck, else
# $HOME/.local/state/skydeck; a variable counts only when it is absolute (starts with a slash).
resolve_state() {
  case ${SKYDECK_HOME-} in
    /*)
      state=$SKYDECK_HOME/state
      return
      ;;
  esac
  case ${XDG_STATE_HOME-} in
    /*)
      state=$XDG_STATE_HOME/skydeck
      return
      ;;
  esac
  state=${HOME-}/.local/state/skydeck
}

main() {
  event=${1-}
  # First, so that the time is as close to the event as it can be.
  time_ns=$(date +%s%N)

  resolve_state
  pid=${CLAUDE_PID-}

  # An unreadable /proc entry gives an empty value; ingest copes with that.
  stat=
  argv=
  boot_id=
  if [ -n "$pid" ]; then
    read -r stat <"/proc/$pid/stat" || stat=
    if [ "$event" = SessionStart ]; then
      argv=$(base64 -w 0 <"/proc/$pid/cmdline") || argv=
    fi
  fi
  read -r boot_id </proc/sys/kernel/random/boot_id || boot_id=

  spool=$state/spool
  name=$time_ns-${pid:-0}-$$.ev
  tmp=$spool/.$name.tmp

  if [ ! -d "$spool" ]; then
    if ! err=$(mkdir -p -- "$spool" 2>&1); then
      log "$err"
      return
    fi
  fi

  # The standard error of the group goes to $err, its standard output to the file.
  if ! err=$(
    {
      printf 'v=1\nevent=%s\ntime_ns=%s\nclaude_pid=%s\nsession_env=%s\nentrypoint_env=%s\nboot_id=%s\nstat=%s\npwd=%s\n' \
        "$event" "$time_ns" "$pid" "${CLAUDE_CODE_SESSION_ID-}" "${CLAUDE_CODE_ENTRYPOINT-}" \
        "$boot_id" "$stat" "${PWD-}" &&
        if [ "$event" = SessionStart ]; then printf 'argv_b64=%s\n' "$argv"; fi &&
        printf -- '--\n' &&
        cat
    } 2>&1 >"$tmp"
  ); then
    log "write failed: $err"
    return
  fi

  if ! err=$(mv -f -- "$tmp" "$spool/$name" 2>&1); then
    log "$err"
  fi
}

main "$@" >/dev/null 2>&1
exit 0
