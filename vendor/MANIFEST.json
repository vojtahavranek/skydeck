    {
      "path": "vendor/xterm/addon-serialize/lib/addon-serialize.mjs",
      "package": "@xterm/addon-serialize",
      "version": "0.14.0",
      "sha256": "d89e18d90232656dfe6004fa75d3efdc8f9abd583760bfeebf531cc31a16d44d",
      "upstreamSha256": "6c93dff90bef3b7aac8664fa4c1cb4026bf4b701f3014a1fb88edde943dab906",
      "patch": "skydeck: _diffStyle turned bold off and dim off both with SGR 22, which turns off both, so a rebuilt cell lost its bold after a dim one, or one of bold and dim when only the other went off. Patched: when bold or dim changes and either goes off, SGR 22 first, then 1 and 2 for what the cell has; otherwise only the codes that go on. Unfixed upstream on 2026-11-13; drop the patch when a release fixes it."
    },
