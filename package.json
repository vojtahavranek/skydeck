{
  "name": "skydeck",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.12"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:page": "node --test \"test-page/**/*.test.ts\"",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:page",
    "vendor": "node scripts/vendor.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/ws": "8.18.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode-graphemes": "0.4.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "playwright": "1.60.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2",
    "ws": "8.23.0"
  }
}
